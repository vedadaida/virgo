# Google Gemini API Key - Get one at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL connection string (Neon.tech or local)
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require

# Upstash Redis URL (optional in direct mode)
REDIS_URL=redis://default:token@host:6379

# GitHub Personal Access Token (with repo / pull_requests permissions)
GITHUB_TOKEN=ghp_your_github_token_here

# GitHub Webhook Secret for X-Hub-Signature-256 verification
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Smee.io Webhook Forwarder URL (for local development)
SMEE_URL=https://smee.io/your_channel_id
